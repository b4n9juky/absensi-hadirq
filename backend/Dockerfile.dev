FROM node:20-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl python3 make g++ pkg-config libcairo2-dev libpango1.0-dev libjpeg-dev libgif-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package*.json ./
RUN npm install
EXPOSE 3001
CMD ["npx", "tsx", "watch", "src/index.ts"]
