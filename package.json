{
  "name": "shakeabsen",
  "version": "1.0.0",
  "private": true,
  "description": "Sistem Absensi Sekolah — ShakeAbsen",
  "scripts": {
    "install:all": "cd frontend && npm install && cd ../backend && npm install",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "cd backend && node dist/index.js",
    "deploy": "bash deploy.sh",
    "db:push": "cd backend && npm run db:push",
    "db:seed": "cd backend && npm run db:seed",
    "android:build": "gradlew.bat assembleDebug",
    "android:install": "gradlew.bat installDebug",
    "android:run": "gradlew.bat assembleDebug && gradlew.bat installDebug"
  }
}
