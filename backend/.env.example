PORT=3001

# MySQL — ganti dengan kredensial dari CyberPanel → Websites → Databases
DATABASE_URL=mysql://user:password@localhost:3306/dbname

# Domain origin (bisa multi-domain, pisah dengan koma)
CORS_ORIGIN=https://domain-anda.sch.id

# Better Auth — ganti SECRET dengan string acak 32+ karakter
BETTER_AUTH_SECRET=ubah_dengan_string_acak_panjang
BETTER_AUTH_URL=https://domain-anda.sch.id

# School timezone: Asia/Jakarta (WIB), Asia/Makassar (WITA), Asia/Jayapura (WIT)
APP_TIMEZONE=Asia/Jakarta

# Geofence (fallback jika tidak tersimpan di database)
SCHOOL_LATITUDE=0.000000
SCHOOL_LONGITUDE=0.000000
SCHOOL_RADIUS_METERS=50
MAX_ACCURACY_METERS=30
