# ========================================
# Hadirq Backend — Environment Variables
# ========================================
# Copy this file to .env and adjust values

# --- Required ---
DATABASE_URL=mysql://hadirq:hadirq123@db:3306/absensi
CORS_ORIGIN=https://absensi.domain.com
BETTER_AUTH_SECRET=replace-with-random-32-char-string
BETTER_AUTH_URL=https://absensi.domain.com

# --- Database (optional overrides) ---
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=absensi
MYSQL_USER=hadirq
MYSQL_PASSWORD=hadirq123

# --- Geofence ---
SCHOOL_LATITUDE=-6.2088
SCHOOL_LONGITUDE=106.8456
SCHOOL_RADIUS_METERS=50
MAX_ACCURACY_METERS=30

# --- App ---
NODE_ENV=production
PORT=3001
APP_TIMEZONE=Asia/Jakarta
KIOSK_SECRET_KEY=change-this-key

# --- WhatsApp (optional) ---
# Proxy untuk koneksi WA (lewati jika network bersih)
# Format: http://proxy:port  atau  socks5://127.0.0.1:1080
WA_PROXY_URL=

# --- Docker Compose only ---
# Digunakan oleh docker-compose.yml untuk tag image ghcr.io
GITHUB_REPO_OWNER=b4n9juky
